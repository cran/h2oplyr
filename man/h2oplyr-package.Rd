\name{h2oplyr-package}
\alias{h2oplyr-package}
\alias{h2oplyr}
\docType{package}
\title{Remote H2O Data Manipulation}
\description{Tidy-style manipulation of H2O frames using H2O as the only data backend. Start a matching H2O cluster explicitly, then use h_penguins() for the included tutorial data.}
\seealso{\code{\link{h_penguins}}, \code{\link{h_summarize}}. Run \code{vignette("h2oplyr-penguins")} for the English tutorial.}
